# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
# Defaults to local MongoDB or embedded in-memory database automatically if not reachable
MONGODB_URI=mongodb://127.0.0.1:27017/grocery_delivery

# JWT Authentication Secrets (Separate for Customer & Admin)
JWT_SECRET=grocery_super_secret_jwt_key_2026_customer
ADMIN_JWT_SECRET=grocery_super_secret_jwt_key_2026_admin_portal

# Cloudinary Credentials (Optional for image storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateway Configuration (Optional - Mock active by default)
PAYMENT_GATEWAY_KEY=rzp_test_placeholder_key
PAYMENT_GATEWAY_SECRET=rzp_test_placeholder_secret
